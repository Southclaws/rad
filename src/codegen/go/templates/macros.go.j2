{% endif %}
{% endfor %}
{% endmacro %}

{% macro order_methods(receiver, query_type, table) %}
{% for column in table.columns %}
func ({{ receiver }} *{{ query_type }}) OrderBy{{ column.field }}() *{{ query_type }} {
	{{ receiver }}.spec.orders = append({{ receiver }}.spec.orders, lirwire.OrderTerm{Expr: lirwire.Col("", {{ column.name_quoted }})})
	return {{ receiver }}
}

func ({{ receiver }} *{{ query_type }}) OrderBy{{ column.field }}Desc() *{{ query_type }} {
	{{ receiver }}.spec.orders = append({{ receiver }}.spec.orders, lirwire.OrderTerm{Expr: lirwire.Col("", {{ column.name_quoted }}), Desc: ptrBool(true)})
	return {{ receiver }}
}
{% endfor %}
{% endmacro %}
