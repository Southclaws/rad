func {{ table.lower_model }}FromRecord(rec protocol.Record) {{ table.model }} {
	m := {{ table.model }}{}
{% for column in table.columns %}
	m.{{ column.field }} = {{ column.record_helper }}(rec, {{ column.name_quoted }})
{% endfor %}
{% for relation in table.forward_relations %}
	if parent, ok := rec[{{ relation.as_quoted }}].(map[string]any); ok {
		v := {{ relation.target_lower_model }}FromRecord(parent)
		m.{{ relation.field }} = &v
	}
{% endfor %}
{% for relation in table.reverse_relations %}
	if kids, ok := rec[{{ relation.as_quoted }}].([]any); ok {
		for _, k := range kids {
			if child, ok := k.(map[string]any); ok {
				m.{{ relation.field }} = append(m.{{ relation.field }}, {{ relation.target_lower_model }}FromRecord(child))
			}
		}
	}
{% endfor %}
	return m
}
