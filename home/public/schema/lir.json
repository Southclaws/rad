{
  "$defs": {
    "AggTerm": {
      "additionalProperties": false,
      "properties": {
        "arg": {
          "$ref": "#/$defs/Expr"
        },
        "as": {
          "minLength": 1,
          "type": "string"
        },
        "fn": {
          "enum": [
            "count",
            "sum",
            "avg",
            "min",
            "max"
          ],
          "type": "string"
        }
      },
      "required": [
        "fn",
        "as"
      ],
      "title": "AggTerm",
      "type": "object"
    },
    "AggregateNode": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "groups"
          ]
        },
        {
          "required": [
            "aggs"
          ]
        }
      ],
      "properties": {
        "aggs": {
          "items": {
            "$ref": "#/$defs/AggTerm"
          },
          "minItems": 1,
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/GroupTerm"
          },
          "minItems": 1,
          "type": "array"
        },
        "input": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "aggregate",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "input"
      ],
      "type": "object"
    },
    "BinaryExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "binary",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/Expr"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "and",
            "or",
            "add",
            "sub",
            "mul",
            "div"
          ],
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "kind",
        "op",
        "left",
        "right"
      ],
      "type": "object"
    },
    "CallExpr": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "$ref": "#/$defs/Expr"
          },
          "type": "array"
        },
        "fn": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "call",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fn",
        "args"
      ],
      "type": "object"
    },
    "CastExpr": {
      "additionalProperties": false,
      "properties": {
        "expr": {
          "$ref": "#/$defs/Expr"
        },
        "kind": {
          "const": "cast",
          "type": "string"
        },
        "to": {
          "enum": [
            "text",
            "int64",
            "float64",
            "bool"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expr",
        "to"
      ],
      "type": "object"
    },
    "ColumnExpr": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "col",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "scope",
        "column"
      ],
      "type": "object"
    },
    "CrossingExprArray": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "array",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node"
      ],
      "type": "object"
    },
    "CrossingExprExists": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exists",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node"
      ],
      "type": "object"
    },
    "CrossingExprFirst": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "first",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node"
      ],
      "type": "object"
    },
    "CrossingExprScalar": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scalar",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node"
      ],
      "type": "object"
    },
    "Expr": {
      "description": "A closed tagged union. Every expression computes one typed datum; crossings are the only relation-to-datum boundary.",
      "oneOf": [
        {
          "$ref": "#/$defs/LiteralExpr"
        },
        {
          "$ref": "#/$defs/ColumnExpr"
        },
        {
          "$ref": "#/$defs/UnaryExpr"
        },
        {
          "$ref": "#/$defs/BinaryExpr"
        },
        {
          "$ref": "#/$defs/CallExpr"
        },
        {
          "$ref": "#/$defs/CastExpr"
        },
        {
          "$ref": "#/$defs/CrossingExprExists"
        },
        {
          "$ref": "#/$defs/CrossingExprFirst"
        },
        {
          "$ref": "#/$defs/CrossingExprScalar"
        },
        {
          "$ref": "#/$defs/CrossingExprArray"
        }
      ],
      "title": "Expr"
    },
    "Field": {
      "additionalProperties": false,
      "properties": {
        "as": {
          "minLength": 1,
          "type": "string"
        },
        "expr": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "as",
        "expr"
      ],
      "title": "Field",
      "type": "object"
    },
    "FilterNode": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "filter",
          "type": "string"
        },
        "predicate": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "kind",
        "input",
        "predicate"
      ],
      "type": "object"
    },
    "GroupTerm": {
      "additionalProperties": false,
      "properties": {
        "as": {
          "minLength": 1,
          "type": "string"
        },
        "expr": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "expr"
      ],
      "title": "GroupTerm",
      "type": "object"
    },
    "JoinNode": {
      "additionalProperties": false,
      "properties": {
        "join": {
          "enum": [
            "inner",
            "left"
          ],
          "type": "string"
        },
        "kind": {
          "const": "join",
          "type": "string"
        },
        "left": {
          "minLength": 1,
          "type": "string"
        },
        "on": {
          "$ref": "#/$defs/Expr"
        },
        "right": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "left",
        "right",
        "join",
        "on"
      ],
      "type": "object"
    },
    "LiteralExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lit",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "Node": {
      "description": "A closed tagged union of the seven LIR relation operators.",
      "oneOf": [
        {
          "$ref": "#/$defs/ScanNode"
        },
        {
          "$ref": "#/$defs/FilterNode"
        },
        {
          "$ref": "#/$defs/ProjectNode"
        },
        {
          "$ref": "#/$defs/JoinNode"
        },
        {
          "$ref": "#/$defs/AggregateNode"
        },
        {
          "$ref": "#/$defs/OrderNode"
        },
        {
          "$ref": "#/$defs/SliceNode"
        }
      ],
      "title": "Node"
    },
    "OrderNode": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "order",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/OrderTerm"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "input",
        "terms"
      ],
      "type": "object"
    },
    "OrderTerm": {
      "additionalProperties": false,
      "properties": {
        "desc": {
          "type": "boolean"
        },
        "expr": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "expr"
      ],
      "title": "OrderTerm",
      "type": "object"
    },
    "ProjectNode": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "spread"
          ]
        },
        {
          "required": [
            "fields"
          ]
        }
      ],
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "minItems": 1,
          "type": "array"
        },
        "input": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "project",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "spread": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "input"
      ],
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/Node"
          },
          "description": "A flat encoding of one finite, single-consumer relation tree. Node IDs name inline definitions and carry no sharing identity.",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "root": {
          "$ref": "#/$defs/Root"
        }
      },
      "required": [
        "nodes",
        "root"
      ],
      "title": "Query",
      "type": "object"
    },
    "Root": {
      "additionalProperties": false,
      "description": "Selects the root relation and its materialisation mode. Scalar requires one output column and statically at most one row.",
      "properties": {
        "cardinality": {
          "enum": [
            "many",
            "first",
            "exactly_one",
            "scalar"
          ],
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "node",
        "cardinality"
      ],
      "title": "Root",
      "type": "object"
    },
    "ScanNode": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scan",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "table",
        "scope"
      ],
      "type": "object"
    },
    "SliceNode": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "slice",
          "type": "string"
        },
        "limit": {
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "input"
      ],
      "type": "object"
    },
    "UnaryExpr": {
      "additionalProperties": false,
      "properties": {
        "expr": {
          "$ref": "#/$defs/Expr"
        },
        "kind": {
          "const": "unary",
          "type": "string"
        },
        "op": {
          "enum": [
            "not",
            "negate",
            "is_null",
            "is_not_null"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "op",
        "expr"
      ],
      "type": "object"
    },
    "Value": {
      "description": "One raw JSON scalar: string, number, boolean, or null. The binder preserves JSON numbers and types literals from context.",
      "format": "raw",
      "title": "Value",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  },
  "$id": "https://www.radengine.dev/schema/lir.json",
  "$ref": "#/$defs/Query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A strict, single-consumer relation tree encoded as named inline node definitions plus a root selector. The normative semantics live in docs/design/lir.md.",
  "title": "Rad LIR"
}
