{{define "runtime" -}}
// querySpec accumulates a fluent builder's state; assemble compiles it into
// the wire's relation tree.
type querySpec struct {
	table    string
	filters  []lirwire.Expr
	orders   []lirwire.OrderTerm
	offset   int
	limit    int
	limitSet bool
	includes []includeSpec
	aggs     []lirwire.AggTerm
}

// includeSpec is one relation field: a correlated sub-query materialised as
// a nested object (first), array, or folded scalar object.
type includeSpec struct {
	table    string
	pairs    [][2]string // scanned-side column = outer-scope column
	as       string
	kind     string // first | array | fold
	filters  []lirwire.Expr
	orders   []lirwire.OrderTerm
	limit    int
	limitSet bool
	nested   []includeSpec
	aggs     []lirwire.AggTerm
}

// ptrBool boxes a bool for the pointer fields the wire structs use.
func ptrBool(b bool) *bool { return &b }

// ptrExpr boxes an expression for the pointer fields the wire structs use.
func ptrExpr(e lirwire.Expr) *lirwire.Expr { return &e }

func assemble(s querySpec) lirwire.Query {
	g := &graphBuilder{nodes: map[string]lirwire.Node{}}
	last, scope := g.chain(s.table, nil, "", s.filters, s.orders, s.offset, s.limit, s.limitSet)
	if len(s.aggs) > 0 {
		id := g.next()
		g.nodes[id] = lirwire.Aggregate(last, "", nil, scopeAggs(s.aggs, scope))
		return lirwire.Query{Nodes: g.nodes, Root: lirwire.Root{Node: id, Cardinality: "exactly_one"}}
	}
	if len(s.includes) > 0 {
		fields := make([]lirwire.Field, len(s.includes))
		for i, inc := range s.includes {
			fields[i] = g.include(inc, scope)
		}
		id := g.next()
		g.nodes[id] = lirwire.Project(last, "", []string{scope}, fields)
		last = id
	}
	return lirwire.Query{Nodes: g.nodes, Root: lirwire.Root{Node: last, Cardinality: "many"}}
}

type graphBuilder struct {
	nodes map[string]lirwire.Node
	n     int
}

func (g *graphBuilder) next() string {
	id := fmt.Sprintf("n%d", g.n)
	g.n++
	return id
}

// chain emits scan → filter → order → slice as needed and returns the last
// node id plus the scan's scope. pairs prepend correlation equalities
// against outerScope.
func (g *graphBuilder) chain(table string, pairs [][2]string, outerScope string, filters []lirwire.Expr, orders []lirwire.OrderTerm, offset, limit int, limitSet bool) (string, string) {
	scope := g.next()
	g.nodes[scope] = lirwire.Scan(table, scope)
	last := scope

	var preds []lirwire.Expr
	for _, pr := range pairs {
		preds = append(preds, lirwire.Binary("eq", lirwire.Col(scope, pr[0]), lirwire.Col(outerScope, pr[1])))
	}
	for _, f := range filters {
		preds = append(preds, scopeExpr(f, scope))
	}
	if pred := lirwire.AndAll(preds); !pred.IsZero() {
		id := g.next()
		g.nodes[id] = lirwire.Filter(last, pred)
		last = id
	}
	if len(orders) > 0 {
		terms := make([]lirwire.OrderTerm, len(orders))
		for i, t := range orders {
			terms[i] = lirwire.OrderTerm{Expr: scopeExpr(t.Expr, scope), Desc: t.Desc}
		}
		id := g.next()
		g.nodes[id] = lirwire.Order(last, terms)
		last = id
	}
	if offset > 0 || limitSet {
		var limitPtr *int
		if limitSet {
			l := limit
			limitPtr = &l
		}
		id := g.next()
		g.nodes[id] = lirwire.Slice(last, offset, limitPtr)
		last = id
	}
	return last, scope
}

func (g *graphBuilder) include(inc includeSpec, outerScope string) lirwire.Field {
	if inc.kind == "fold" {
		last, scope := g.chain(inc.table, inc.pairs, outerScope, inc.filters, nil, 0, 0, false)
		id := g.next()
		g.nodes[id] = lirwire.Aggregate(last, "", nil, scopeAggs(inc.aggs, scope))
		return lirwire.Field{As: inc.as, Expr: lirwire.First(id)}
	}
	last, scope := g.chain(inc.table, inc.pairs, outerScope, inc.filters, inc.orders, 0, inc.limit, inc.limitSet)
	if len(inc.nested) > 0 {
		fields := make([]lirwire.Field, len(inc.nested))
		for i, n := range inc.nested {
			fields[i] = g.include(n, scope)
		}
		id := g.next()
		g.nodes[id] = lirwire.Project(last, "", []string{scope}, fields)
		last = id
	}
	if inc.kind == "first" {
		return lirwire.Field{As: inc.as, Expr: lirwire.First(last)}
	}
	return lirwire.Field{As: inc.as, Expr: lirwire.Array(last)}
}

// scopeExpr fills unscoped column references with the relation's scope,
// rebuilding the expression tree against the union (the wire Expr is
// immutable — there is nothing to mutate in place).
func scopeExpr(e lirwire.Expr, scope string) lirwire.Expr {
	switch x := e.ExprUnion.(type) {
	case *lirwire.ColumnExpr:
		if x.Scope == "" {
			return lirwire.Col(scope, x.Column)
		}
		return e
	case *lirwire.UnaryExpr:
		return lirwire.Unary(x.Op, scopeExpr(x.Expr, scope))
	case *lirwire.BinaryExpr:
		return lirwire.Binary(x.Op, scopeExpr(x.Left, scope), scopeExpr(x.Right, scope))
	case *lirwire.CastExpr:
		return lirwire.Cast(scopeExpr(x.Expr, scope), x.To)
	default: // lit, crossings, nil: nothing to scope
		return e
	}
}

// assembleGrouped compiles the spec into a grouped fold: one row per
// distinct value of groupCol, counted, ordered by the group key. The
// aggregate binds an output scope so the ordering can address its key —
// relational closure on the wire.
func assembleGrouped(s querySpec, groupCol string) lirwire.Query {
	g := &graphBuilder{nodes: map[string]lirwire.Node{}}
	last, scope := g.chain(s.table, nil, "", s.filters, nil, 0, 0, false)
	agg := g.next()
	g.nodes[agg] = lirwire.Aggregate(last, agg,
		[]lirwire.GroupTerm{ {Expr: lirwire.Col(scope, groupCol)} },
		[]lirwire.AggTerm{ {Fn: "count", As: "count"} })
	ord := g.next()
	g.nodes[ord] = lirwire.Order(agg, []lirwire.OrderTerm{ {Expr: lirwire.Col(agg, groupCol)} })
	return lirwire.Query{Nodes: g.nodes, Root: lirwire.Root{Node: ord, Cardinality: "many"}}
}

func scopeAggs(aggs []lirwire.AggTerm, scope string) []lirwire.AggTerm {
	out := make([]lirwire.AggTerm, len(aggs))
	for i, a := range aggs {
		var arg *lirwire.Expr
		if a.Arg != nil {
			arg = ptrExpr(scopeExpr(*a.Arg, scope))
		}
		out[i] = lirwire.AggTerm{Fn: a.Fn, Arg: arg, As: a.As}
	}
	return out
}
