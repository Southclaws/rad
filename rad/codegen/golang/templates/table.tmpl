// {{$model}}CountBy{{.Field}} is one per-{{.Name}} row count.
type {{$model}}CountBy{{.Field}} struct {
	{{.Field}} {{keyType .}}
	Count int64
}

// CountBy{{.Field}} counts matching rows per distinct {{printf "%q" .Name}}, ordered by the
// group key — one round trip, no rows fetched.
func (q *{{$q}}) CountBy{{.Field}}(ctx context.Context) ([]{{$model}}CountBy{{.Field}}, error) {
	spec := q.spec
	spec.filters = q.spec.filters
	recs, err := q.v.Query(ctx, assembleGrouped(spec, {{printf "%q" .Name}}))
	if err != nil {
		return nil, err
	}
	out := make([]{{$model}}CountBy{{.Field}}, len(recs))
	for i, r := range recs {
		out[i] = {{$model}}CountBy{{.Field}}{ {{.Field}}: {{recHelper .}}(r, {{printf "%q" .Name}}), Count: recInt64(r, "count") }
	}
	return out, nil
}
