func (b *{{$inc}}) Include{{.Field}}(opts ...func(*{{.Target.Model}}Include)) *{{$inc}} {
	n := &{{.Target.Model}}Include{spec: includeSpec{table: {{printf "%q" .Target.Name}}, pairs: {{pairsLit .Pairs}}, as: {{printf "%q" .As}}, kind: "first"}}
