func {{lowerFirst $model}}FromRecord(rec protocol.Record) {{$model}} {
	m := {{$model}}{}
{{- range .Cols}}
	m.{{.Field}} = {{recHelper .}}(rec, {{printf "%q" .Name}})
{{- end}}
{{- range .Forward}}
	if parent, ok := rec[{{printf "%q" .As}}].(map[string]any); ok {
		v := {{lowerFirst .Target.Model}}FromRecord(parent)
		m.{{.Field}} = &v
	}
{{- end}}
{{- range .Reverse}}
	if kids, ok := rec[{{printf "%q" .As}}].([]any); ok {
		for _, k := range kids {
			if child, ok := k.(map[string]any); ok {
				m.{{.Field}} = append(m.{{.Field}}, {{lowerFirst .Target.Model}}FromRecord(child))
			}
		}
	}
{{- end}}
	return m
}
{{end}}

