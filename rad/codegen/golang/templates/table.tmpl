// {{$model}} is one row of {{printf "%q" $name}}. Relation fields are populated only when the
// corresponding Include* option was used on the query.
type {{$model}} struct {
{{- range .Cols}}
	{{.Field}} {{if .Nullable}}*{{end}}{{.GoType}} `json:"{{.Name}}{{jsonOmit .Nullable}}"`
{{- end}}
{{- range .Forward}}
	{{.Field}} *{{.Target.Model}} `json:"{{.As}},omitempty"`
{{- end}}
{{- range .Reverse}}
	{{.Field}} []{{.Target.Model}} `json:"{{.As}},omitempty"`
{{- end}}
}

// {{$model}}Create is the input to Create. Pointer fields are optional:
// nil defers to the column default or NULL.
type {{$model}}Create struct {
{{- range .Cols}}
	{{.Field}} {{if or .Nullable .HasDef}}*{{end}}{{.GoType}}
{{- end}}
}

// {{$model}}Patch is the input to Update. Nil fields are left untouched;
// Clear* sets a nullable column to NULL.
type {{$model}}Patch struct {
{{- range .Cols}}{{if not .IsPK}}
	{{.Field}} *{{.GoType}}
{{- end}}{{end}}
{{- range .Cols}}{{if and (not .IsPK) .Nullable}}
	Clear{{.Field}} bool
{{- end}}{{end}}
}

// {{$model}}Table provides typed access to {{printf "%q" $name}}.
type {{$model}}Table struct{ v radclient.View }

func (t {{$model}}Table) Create(ctx context.Context, in {{$model}}Create) ({{$model}}, error) {
	values := map[string]any{}
{{- range .Cols}}
{{- if or .Nullable .HasDef}}
	if in.{{.Field}} != nil {
		values[{{printf "%q" .Name}}] = *in.{{.Field}}
	}
{{- else}}
	values[{{printf "%q" .Name}}] = in.{{.Field}}
{{- end}}
{{- end}}
	rec, err := t.v.Create(ctx, {{printf "%q" $name}}, values)
	if err != nil {
		return {{$model}}{}, err
	}
	return {{lowerFirst $model}}FromRecord(rec), nil
}

func (t {{$model}}Table) Get(ctx context.Context, {{pkParams $t}}) ({{$model}}, bool, error) {
	rec, found, err := t.v.Get(ctx, {{printf "%q" $name}}, {{pkKeyMap $t}})
	if err != nil || !found {
		return {{$model}}{}, false, err
	}
	return {{lowerFirst $model}}FromRecord(rec), true, nil
}

func (t {{$model}}Table) Update(ctx context.Context, {{pkParams $t}}, patch {{$model}}Patch) ({{$model}}, bool, error) {
	set := map[string]any{}
	var clear []string
{{- range .Cols}}{{if not .IsPK}}
	if patch.{{.Field}} != nil {
		set[{{printf "%q" .Name}}] = *patch.{{.Field}}
	}
{{- if .Nullable}}
	if patch.Clear{{.Field}} {
		clear = append(clear, {{printf "%q" .Name}})
	}
{{- end}}
{{- end}}{{end}}
	rec, found, err := t.v.Update(ctx, {{printf "%q" $name}}, {{pkKeyMap $t}}, set, clear)
	if err != nil || !found {
		return {{$model}}{}, false, err
	}
	return {{lowerFirst $model}}FromRecord(rec), true, nil
}

func (t {{$model}}Table) Delete(ctx context.Context, {{pkParams $t}}) (bool, error) {
	return t.v.Delete(ctx, {{printf "%q" $name}}, {{pkKeyMap $t}})
}

{{range .Uniques}}
// {{uqName .}} finds the row by the unique index on ({{uqCols .}}).
func (t {{$model}}Table) {{uqName .}}(ctx context.Context, {{uqParams .}}) ({{$model}}, bool, error) {
	recs, err := t.v.Query(ctx, assemble(querySpec{table: {{printf "%q" $name}}, orders: {{defaultOrderTerms $t}}, limit: 1, limitSet: true, filters: []lirwire.Expr{
{{- range .}}
		lirwire.Binary("eq", lirwire.Col("", {{printf "%q" .Name}}), lirwire.LitOf({{lowerFirst .Field}})),
{{- end}}
	}}))
	if err != nil || len(recs) == 0 {
		return {{$model}}{}, false, err
	}
	return {{lowerFirst $model}}FromRecord(recs[0]), true, nil
}
{{end}}
func (t {{$model}}Table) Query() *{{$q}} {
	return &{{$q}}{v: t.v, spec: querySpec{table: {{printf "%q" $name}}}}
}

// {{$q}} is a fluent query builder for {{printf "%q" $name}}. Conditions AND together.
type {{$q}} struct {
	v    radclient.View
	spec querySpec
}

{{template "filterMethods" dict "Recv" "q" "QType" $q "Table" $t}}
{{template "orderMethods" dict "Recv" "q" "QType" $q "Table" $t}}
func (q *{{$q}}) Limit(n int) *{{$q}}  { q.spec.limit, q.spec.limitSet = n, true; return q }
func (q *{{$q}}) Offset(n int) *{{$q}} { q.spec.offset = n; return q }

{{range .Forward}}
// Include{{.Field}} embeds the referenced {{.Target.Model}} (nil when the FK is NULL).
func (q *{{$q}}) Include{{.Field}}(opts ...func(*{{.Target.Model}}Include)) *{{$q}} {
	b := &{{.Target.Model}}Include{spec: includeSpec{table: {{printf "%q" .Target.Name}}, pairs: {{pairsLit .Pairs}}, as: {{printf "%q" .As}}, kind: "first"}}
	for _, o := range opts {
		o(b)
	}
	inc := b.spec
	q.spec.includes = append(q.spec.includes, inc)
	return q
}
{{end}}
{{- range .Reverse}}
// Include{{.Field}} embeds the {{.Target.Model}} rows referencing this row.
func (q *{{$q}}) Include{{.Field}}(opts ...func(*{{.Target.Model}}Include)) *{{$q}} {
	b := &{{.Target.Model}}Include{spec: includeSpec{table: {{printf "%q" .Target.Name}}, pairs: {{pairsLit .Pairs}}, as: {{printf "%q" .As}}, kind: "array"}}
	for _, o := range opts {
		o(b)
	}
	inc := b.spec
	q.spec.includes = append(q.spec.includes, inc)
	return q
}
{{end}}
// All executes the query.
func (q *{{$q}}) All(ctx context.Context) ([]{{$model}}, error) {
	recs, err := q.v.Query(ctx, assemble(q.spec))
	if err != nil {
		return nil, err
	}
	out := make([]{{$model}}, len(recs))
	for i, r := range recs {
		out[i] = {{lowerFirst $model}}FromRecord(r)
	}
	return out, nil
}

// First executes the query with limit 1.
func (q *{{$q}}) First(ctx context.Context) ({{$model}}, bool, error) {
	if len(q.spec.orders) == 0 {
		q.spec.orders = {{defaultOrderTerms $t}}
	}
	q.spec.limit, q.spec.limitSet = 1, true
	rows, err := q.All(ctx)
	if err != nil || len(rows) == 0 {
		return {{$model}}{}, false, err
	}
	return rows[0], true, nil
}

// fold sends the builder's filter as an aggregate query and returns the
// one scalar record the server produces.
func (q *{{$q}}) fold(ctx context.Context, aggs []lirwire.AggTerm) (protocol.Record, error) {
	spec := q.spec
	spec.orders, spec.includes, spec.limit, spec.limitSet, spec.offset = nil, nil, 0, false, 0
	spec.aggs = aggs
	recs, err := q.v.Query(ctx, assemble(spec))
	if err != nil || len(recs) == 0 {
		return protocol.Record{}, err
	}
	return recs[0], nil
}

// Count returns how many rows match (never NULL: 0 when none).
func (q *{{$q}}) Count(ctx context.Context) (int64, error) {
	rec, err := q.fold(ctx, []lirwire.AggTerm{ {Fn: "count", As: "v"} })
	if err != nil {
		return 0, err
	}
	return recInt64(rec, "v"), nil
}
