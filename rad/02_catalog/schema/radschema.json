{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radengine.dev/schema.rad.json",
  "title": "Rad declarative schema (schema.rad)",
  "type": "object",
  "required": [
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "table": {
      "type": "object",
      "required": [
        "name",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "renamed_from": {
          "$ref": "#/$defs/identifier"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "string",
            "int64",
            "float64",
            "bool"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "pk": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "index": {
          "type": "boolean"
        },
        "ref": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
          "description": "Foreign key target as table.column (must be the target's primary key)"
        },
        "format": {
          "$ref": "#/$defs/identifier"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Literal of the column's type, or a generator: uuid(), now_ms()"
        },
        "renamed_from": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "index": {
      "type": "object",
      "required": [
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "unique": {
          "type": "boolean"
        }
      }
    }
  }
}