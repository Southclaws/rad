{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.radengine.dev/schema/lir.json",
  "title": "Rad LIR",
  "description": "A strict, single-consumer relation tree encoded as named inline node definitions plus a root selector. The normative semantics live in docs/design/lir.md.",
  "$ref": "#/$defs/Query",
  "$defs": {
    "Value": {
      "title": "Value",
      "description": "One raw JSON scalar: string, number, boolean, or null. The binder preserves JSON numbers and types literals from context.",
      "type": ["string", "number", "boolean", "null"]
    },
    "Query": {
      "title": "Query",
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "root"],
      "properties": {
        "nodes": {
          "description": "A flat encoding of one finite, single-consumer relation tree. Node IDs name inline definitions and carry no sharing identity.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/Node" }
        },
        "root": { "$ref": "#/$defs/Root" }
      }
    },
    "Root": {
      "title": "Root",
      "description": "Selects the root relation and its materialisation mode. Scalar requires one output column and statically at most one row.",
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "cardinality"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "cardinality": {
          "type": "string",
          "enum": ["many", "first", "exactly_one", "scalar"]
        }
      }
    },

    "Node": {
      "title": "Node",
      "description": "A closed tagged union of the seven LIR relation operators.",
      "oneOf": [
        { "$ref": "#/$defs/ScanNode" },
        { "$ref": "#/$defs/FilterNode" },
        { "$ref": "#/$defs/ProjectNode" },
        { "$ref": "#/$defs/JoinNode" },
        { "$ref": "#/$defs/AggregateNode" },
        { "$ref": "#/$defs/OrderNode" },
        { "$ref": "#/$defs/SliceNode" }
      ]
    },
    "ScanNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "table", "scope"],
      "properties": {
        "kind": { "type": "string", "const": "scan" },
        "table": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "FilterNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input", "predicate"],
      "properties": {
        "kind": { "type": "string", "const": "filter" },
        "input": { "type": "string", "minLength": 1 },
        "predicate": { "$ref": "#/$defs/Expr" }
      }
    },
    "ProjectNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input"],
      "anyOf": [
        { "required": ["spread"] },
        { "required": ["fields"] }
      ],
      "properties": {
        "kind": { "type": "string", "const": "project" },
        "input": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "spread": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Field" }
        }
      }
    },
    "JoinNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "left", "right", "join", "on"],
      "properties": {
        "kind": { "type": "string", "const": "join" },
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "join": { "type": "string", "enum": ["inner", "left"] },
        "on": { "$ref": "#/$defs/Expr" }
      }
    },
    "AggregateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input"],
      "anyOf": [
        { "required": ["groups"] },
        { "required": ["aggs"] }
      ],
      "properties": {
        "kind": { "type": "string", "const": "aggregate" },
        "input": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/GroupTerm" }
        },
        "aggs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AggTerm" }
        }
      }
    },
    "OrderNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input", "terms"],
      "properties": {
        "kind": { "type": "string", "const": "order" },
        "input": { "type": "string", "minLength": 1 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OrderTerm" }
        }
      }
    },
    "SliceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input"],
      "properties": {
        "kind": { "type": "string", "const": "slice" },
        "input": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 }
      }
    },

    "Expr": {
      "title": "Expr",
      "description": "A closed tagged union. Every expression computes one typed datum; crossings are the only relation-to-datum boundary.",
      "oneOf": [
        { "$ref": "#/$defs/LiteralExpr" },
        { "$ref": "#/$defs/ColumnExpr" },
        { "$ref": "#/$defs/UnaryExpr" },
        { "$ref": "#/$defs/BinaryExpr" },
        { "$ref": "#/$defs/CallExpr" },
        { "$ref": "#/$defs/CastExpr" },
        { "$ref": "#/$defs/CrossingExprExists" },
        { "$ref": "#/$defs/CrossingExprFirst" },
        { "$ref": "#/$defs/CrossingExprScalar" },
        { "$ref": "#/$defs/CrossingExprArray" }
      ]
    },
    "LiteralExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "const": "lit" },
        "value": { "$ref": "#/$defs/Value" }
      }
    },
    "ColumnExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "column"],
      "properties": {
        "kind": { "type": "string", "const": "col" },
        "scope": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 }
      }
    },
    "UnaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "op", "expr"],
      "properties": {
        "kind": { "type": "string", "const": "unary" },
        "op": { "type": "string", "enum": ["not", "negate", "is_null", "is_not_null"] },
        "expr": { "$ref": "#/$defs/Expr" }
      }
    },
    "BinaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "op", "left", "right"],
      "properties": {
        "kind": { "type": "string", "const": "binary" },
        "op": { "type": "string", "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "and", "or", "add", "sub", "mul", "div"] },
        "left": { "$ref": "#/$defs/Expr" },
        "right": { "$ref": "#/$defs/Expr" }
      }
    },
    "CallExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fn", "args"],
      "properties": {
        "kind": { "type": "string", "const": "call" },
        "fn": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/Expr" }
        }
      }
    },
    "CastExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expr", "to"],
      "properties": {
        "kind": { "type": "string", "const": "cast" },
        "expr": { "$ref": "#/$defs/Expr" },
        "to": { "type": "string", "enum": ["text", "int64", "float64", "bool"] }
      }
    },
    "CrossingExprExists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node"],
      "properties": {
        "kind": { "type": "string", "const": "exists" },
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "CrossingExprFirst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node"],
      "properties": {
        "kind": { "type": "string", "const": "first" },
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "CrossingExprScalar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node"],
      "properties": {
        "kind": { "type": "string", "const": "scalar" },
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "CrossingExprArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node"],
      "properties": {
        "kind": { "type": "string", "const": "array" },
        "node": { "type": "string", "minLength": 1 }
      }
    },

    "Field": {
      "title": "Field",
      "type": "object",
      "additionalProperties": false,
      "required": ["as", "expr"],
      "properties": {
        "as": { "type": "string", "minLength": 1 },
        "expr": { "$ref": "#/$defs/Expr" }
      }
    },
    "GroupTerm": {
      "title": "GroupTerm",
      "type": "object",
      "additionalProperties": false,
      "required": ["expr"],
      "properties": {
        "as": { "type": "string", "minLength": 1 },
        "expr": { "$ref": "#/$defs/Expr" }
      }
    },
    "AggTerm": {
      "title": "AggTerm",
      "type": "object",
      "additionalProperties": false,
      "required": ["fn", "as"],
      "properties": {
        "fn": { "type": "string", "enum": ["count", "sum", "avg", "min", "max"] },
        "arg": { "$ref": "#/$defs/Expr" },
        "as": { "type": "string", "minLength": 1 }
      }
    },
    "OrderTerm": {
      "title": "OrderTerm",
      "type": "object",
      "additionalProperties": false,
      "required": ["expr"],
      "properties": {
        "expr": { "$ref": "#/$defs/Expr" },
        "desc": { "type": "boolean" }
      }
    }
  }
}
