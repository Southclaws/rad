{
  "name": "null_heavy",
  "description": "Count rows in a column whose NULL fraction is eighty percent.",
  "warmup": 1,
  "iterations": 8,
  "expect_rows": 1,
  "expect_result": { "event_count": 800 },
  "program": {
    "statements": [{
      "name": "null_heavy",
      "kind": "query",
      "relation": {
        "nodes": {
          "events": { "kind": "scan", "table": "events", "scope": "e" },
          "selected": {
            "kind": "filter", "input": "events",
            "predicate": {
              "kind": "unary", "op": "is_null",
              "expr": { "kind": "col", "scope": "e", "column": "optional_tag" }
            }
          },
          "counted": {
            "kind": "aggregate", "input": "selected", "scope": "result",
            "aggs": [{ "fn": "count", "as": "event_count" }]
          }
        },
        "root": { "node": "counted", "cardinality": "exactly_one" }
      }
    }]
  }
}
