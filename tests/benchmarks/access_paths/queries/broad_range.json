{
  "name": "broad_range",
  "description": "Count an eighty-percent range over an indexed uniform score.",
  "warmup": 1,
  "iterations": 8,
  "expect_rows": 1,
  "expect_result": { "event_count": 800 },
  "program": {
    "statements": [{
      "name": "broad_range",
      "kind": "query",
      "relation": {
        "nodes": {
          "events": { "kind": "scan", "table": "events", "scope": "e" },
          "selected": {
            "kind": "filter", "input": "events",
            "predicate": {
              "kind": "binary", "op": "and",
              "left": {
                "kind": "binary", "op": "gte",
                "left": { "kind": "col", "scope": "e", "column": "score" },
                "right": { "kind": "lit", "value": { "type": "int64", "value": "100" } }
              },
              "right": {
                "kind": "binary", "op": "lt",
                "left": { "kind": "col", "scope": "e", "column": "score" },
                "right": { "kind": "lit", "value": { "type": "int64", "value": "900" } }
              }
            }
          },
          "counted": {
            "kind": "aggregate", "input": "selected", "scope": "result",
            "aggs": [{ "fn": "count", "as": "event_count" }]
          }
        },
        "root": { "node": "counted", "cardinality": "exactly_one" }
      }
    }]
  }
}
