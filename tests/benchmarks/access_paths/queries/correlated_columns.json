{
  "name": "correlated_columns",
  "description": "Count a conjunction whose two columns have full correlation.",
  "warmup": 1,
  "iterations": 8,
  "expect_rows": 1,
  "expect_result": { "event_count": 500 },
  "program": {
    "statements": [{
      "name": "correlated_columns",
      "kind": "query",
      "relation": {
        "nodes": {
          "events": { "kind": "scan", "table": "events", "scope": "e" },
          "selected": {
            "kind": "filter", "input": "events",
            "predicate": {
              "kind": "binary", "op": "and",
              "left": {
                "kind": "binary", "op": "eq",
                "left": { "kind": "col", "scope": "e", "column": "region" },
                "right": { "kind": "lit", "value": { "type": "text", "value": "north" } }
              },
              "right": {
                "kind": "binary", "op": "eq",
                "left": { "kind": "col", "scope": "e", "column": "segment" },
                "right": { "kind": "lit", "value": { "type": "text", "value": "consumer" } }
              }
            }
          },
          "counted": {
            "kind": "aggregate", "input": "selected", "scope": "result",
            "aggs": [{ "fn": "count", "as": "event_count" }]
          }
        },
        "root": { "node": "counted", "cardinality": "exactly_one" }
      }
    }]
  }
}
