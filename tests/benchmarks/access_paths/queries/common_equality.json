{
  "name": "common_equality",
  "description": "Count the rows that have the most common indexed category.",
  "warmup": 1,
  "iterations": 8,
  "expect_rows": 1,
  "expect_result": { "event_count": 700 },
  "program": {
    "statements": [{
      "name": "common_equality",
      "kind": "query",
      "relation": {
        "nodes": {
          "events": { "kind": "scan", "table": "events", "scope": "e" },
          "selected": {
            "kind": "filter", "input": "events",
            "predicate": {
              "kind": "binary", "op": "eq",
              "left": { "kind": "col", "scope": "e", "column": "category" },
              "right": { "kind": "lit", "value": { "type": "text", "value": "hot" } }
            }
          },
          "counted": {
            "kind": "aggregate", "input": "selected", "scope": "result",
            "aggs": [{ "fn": "count", "as": "event_count" }]
          }
        },
        "root": { "node": "counted", "cardinality": "exactly_one" }
      }
    }]
  }
}
