{
  "program": {
    "statements": [
      {
        "name": "tasks_with_maybe_board",
        "kind": "query",
        "relation": {
          "nodes": {
            "tasks": { "kind": "scan", "table": "tasks", "scope": "t" },
            "boards": { "kind": "scan", "table": "boards", "scope": "b" },
            "board_of": {
              "kind": "filter",
              "input": "boards",
              "predicate": {
                "kind": "binary", "op": "eq",
                "left": { "kind": "col", "scope": "b", "column": "id" },
                "right": { "kind": "col", "scope": "t", "column": "board_id" }
              }
            },
            "out": {
              "kind": "project",
              "input": "tasks",
              "scope": "o",
              "spread": ["t"],
              "fields": [
                { "as": "board", "expr": { "kind": "first", "node": "board_of" } }
              ]
            },
            "sorted": {
              "kind": "order",
              "input": "out",
              "terms": [ { "expr": { "kind": "col", "scope": "o", "column": "id" } } ]
            }
          },
          "root": { "node": "sorted", "cardinality": "many" }
        }
      }
    ]
  },
  "result": [
    { "id": "task-linked", "board_id": "board-1", "title": "Linked", "board": { "id": "board-1", "name": "Launch" } },
    { "id": "task-orphan", "board_id": null, "title": "Orphan", "board": null }
  ]
}
