# group parents by a correlated scalar(count of children): the crossing is a
# GROUP BY term. Rows grouped by their per-parent child count.
tables:
  - name: parents
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: children
    columns:
      - { name: id,        type: string, pk: true }
      - { name: parent_id, type: string, nullable: true, ref: parents.id }
