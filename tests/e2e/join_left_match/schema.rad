# e2e/join_left_match — a left join where the left employee row has a matching
# right department; the right attributes come through populated.
tables:
  - name: departments
    columns:
      - { name: dept_id,   type: string, pk: true }
      - { name: dept_name, type: string }

  - name: employees
    columns:
      - { name: emp_id,   type: string, pk: true }
      - { name: emp_name, type: string }
      - { name: emp_dept, type: string, nullable: true, ref: departments.dept_id }
