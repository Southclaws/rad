# e2e/mut_delete_fk_restrict — a negative fixture: deleting a parent row that
# a child row still references through a foreign key must fail (restrict
# semantics; the POC has no cascades).
tables:
  - name: teams
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: boards
    columns:
      - { name: id,      type: string, pk: true }
      - { name: team_id, type: string, ref: teams.id }
      - { name: name,    type: string }
