# probe_idx_desc — desc ordering over an indexed column must force a sort
# (KV is ascending-only), so a desc + limit result must still be correct.
tables:
  - id: 1
    name: t
    columns:
      - { id: 1, name: id, type: string, pk: true }
      - { id: 2, name: n,  type: int64 }
    indexes:
      - { columns: [n] }
