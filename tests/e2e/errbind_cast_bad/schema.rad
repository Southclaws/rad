# e2e/errbind_cast_bad — negative: casting a non-numeric text to int64 has no
# valid conversion. Code and detail captured by running.
tables:
  - id: 1
    name: widgets
    columns:
      - { id: 1, name: id,   type: string, pk: true }
      - { id: 2, name: name, type: string }
      - { id: 3, name: qty,  type: int64 }
