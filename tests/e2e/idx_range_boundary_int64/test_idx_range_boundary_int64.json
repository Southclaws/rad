        "root": { "node": "sorted", "cardinality": "many" }
      },
      "expect": [ { "id": "zero", "n": 0 } ]
    },
    {
      "name": "range spanning sign boundary gt -100 AND lt 1",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "t", "scope": "t" },
          "kept": {
            "kind": "filter", "input": "t",
            "predicate": {
              "kind": "binary", "op": "and",
              "left": { "kind": "binary", "op": "gt", "left": { "kind": "col", "scope": "t", "column": "n" }, "right": { "kind": "lit", "value": -100 } },
              "right": { "kind": "binary", "op": "lt", "left": { "kind": "col", "scope": "t", "column": "n" }, "right": { "kind": "lit", "value": 1 } }
