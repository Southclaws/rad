# e2e/errbind_cyclic — two nodes referencing each other form a cycle; the graph
# must be acyclic. Code captured by running.
tables:
  - id: 1
    name: widgets
    columns:
      - { id: 1, name: id,   type: string, pk: true }
      - { id: 2, name: name, type: string }
      - { id: 3, name: qty,  type: int64 }
