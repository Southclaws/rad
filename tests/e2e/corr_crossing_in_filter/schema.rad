# A crossing embedded inside a filter predicate:
# filter(parents, scalar(count of my children) > 1).
tables:
  - name: parents
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: children
    columns:
      - { name: id,        type: string, pk: true }
      - { name: parent_id, type: string, nullable: true, ref: parents.id }
