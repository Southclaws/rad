{
  "program": {
    "statements": [
      {
        "name": "nodes_with_children",
        "kind": "query",
        "relation": {
          "nodes": {
            "n": { "kind": "scan", "table": "nodes", "scope": "n" },
            "c": { "kind": "scan", "table": "nodes", "scope": "c" },
            "children_of": {
              "kind": "filter",
              "input": "c",
              "predicate": {
                "kind": "binary", "op": "eq",
                "left": { "kind": "col", "scope": "c", "column": "parent_id" },
                "right": { "kind": "col", "scope": "n", "column": "id" }
              }
            },
            "child_proj": {
              "kind": "project",
              "input": "children_of",
              "scope": "cp",
              "fields": [
                { "as": "cid", "expr": { "kind": "col", "scope": "c", "column": "id" } }
              ]
            },
            "children_sorted": {
              "kind": "order",
              "input": "child_proj",
              "terms": [ { "expr": { "kind": "col", "scope": "cp", "column": "cid" } } ]
            },
            "out": {
              "kind": "project",
              "input": "n",
              "scope": "o",
              "fields": [
                { "as": "id",       "expr": { "kind": "col", "scope": "n", "column": "id" } },
                { "as": "children", "expr": { "kind": "array", "node": "children_sorted" } }
              ]
            },
            "sorted": {
              "kind": "order",
              "input": "out",
              "terms": [ { "expr": { "kind": "col", "scope": "o", "column": "id" } } ]
            }
          },
          "root": { "node": "sorted", "cardinality": "many" }
        }
      }
    ]
  },
  "result": [
    { "id": "n1", "children": [ { "cid": "n2" }, { "cid": "n3" } ] },
    { "id": "n2", "children": [ { "cid": "n4" } ] },
    { "id": "n3", "children": [] },
    { "id": "n4", "children": [] },
    { "id": "n5", "children": [] }
  ]
}
