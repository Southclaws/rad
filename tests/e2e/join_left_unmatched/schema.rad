# e2e/join_left_unmatched — a left join where the left employee row has no
# matching right department (its FK is NULL, so the `on` comparison is
# UNKNOWN); the right attributes must be padded with NULL, and the left row is
# still kept.
tables:
  - id: 1
    name: departments
    columns:
      - { id: 1, name: dept_id,   type: string, pk: true }
      - { id: 2, name: dept_name, type: string }

  - id: 2
    name: employees
    columns:
      - { id: 1, name: emp_id,   type: string, pk: true }
      - { id: 2, name: emp_name, type: string }
      - { id: 3, name: emp_dept, type: string, nullable: true, ref: departments.dept_id }
