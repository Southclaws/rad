# probe_idx_mutation_scan — in one program, insert a row then run an index
# range scan. The scan must see the just-inserted row through the index (the
# statement-snapshot invariant: a later statement sees earlier effects).
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: n,  type: int64 }
    indexes:
      - { columns: [n] }
