# e2e/agg_group_by_multi — GROUP BY two columns, one output row per distinct
# (region, category) pair, ordered by both keys.
tables:
  - name: sales
    columns:
      - { name: id,       type: string, pk: true }
      - { name: region,   type: string }
      - { name: category, type: string }
      - { name: amount,   type: int64 }
