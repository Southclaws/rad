# e2e/card_* — minimal schema for the root-cardinality family: one table with
# a primary key, a text column, and an int rank so fixtures can exercise
# exactly_one / scalar / first roots against PK-eq filters and ordered scans.
tables:
  - name: widgets
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }
      - { name: rank, type: int64 }
