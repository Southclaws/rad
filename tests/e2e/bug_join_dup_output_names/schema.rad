# bug: a self-join produces an output row type with duplicate column names
# (id and val appear once per side). The binder rejects this for a binding
# body (bind.go:130-136) but NOT for a query root, so the colliding object
# collapses in JSON, silently dropping the left side's columns.
tables:
  - name: items
    columns:
      - { name: id,  type: string, pk: true }
      - { name: val, type: int64 }
