# sum() over parents whose argument is a correlated scalar(count of children):
# the crossing is an aggregate argument, evaluated per input row then folded.
tables:
  - name: parents
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: children
    columns:
      - { name: id,        type: string, pk: true }
      - { name: parent_id, type: string, nullable: true, ref: parents.id }
