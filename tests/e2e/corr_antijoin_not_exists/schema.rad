# anti-join: filter parents to those with NO children via not(exists(...)).
# The crossing sits under a NOT inside a filter predicate.
tables:
  - id: 1
    name: parents
    columns:
      - { id: 1, name: id,   type: string, pk: true }
      - { id: 2, name: name, type: string }

  - id: 2
    name: children
    columns:
      - { id: 1, name: id,        type: string, pk: true }
      - { id: 2, name: parent_id, type: string, nullable: true, ref: parents.id }
