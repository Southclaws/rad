# anti-join: filter parents to those with NO children via not(exists(...)).
# The crossing sits under a NOT inside a filter predicate.
tables:
  - name: parents
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: children
    columns:
      - { name: id,        type: string, pk: true }
      - { name: parent_id, type: string, nullable: true, ref: parents.id }
