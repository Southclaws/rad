{
  "program": {
    "statements": [
      {
        "name": "author",
        "kind": "create",
        "table": "users",
        "relation": {
          "nodes": { "r": { "kind": "rows", "scope": "r",
            "columns": [ { "name": "id", "type": "text" }, { "name": "name", "type": "text" } ],
            "rows": [ ["u1", "Ada"] ] } },
          "root": { "node": "r", "cardinality": "many" }
        }
      },
      {
        "name": "post",
        "kind": "create",
        "table": "posts",
        "relation": {
          "nodes": {
            "a": { "kind": "ref", "binding": "author", "scope": "a" },
            "p": { "kind": "project", "input": "a", "fields": [
              { "as": "id",      "expr": { "kind": "lit", "value": { "type": "text", "value": "p1" } } },
              { "as": "user_id", "expr": { "kind": "col", "scope": "a", "column": "id" } },
              { "as": "title",   "expr": { "kind": "lit", "value": { "type": "text", "value": "hello" } } }
            ] }
          },
          "root": { "node": "p", "cardinality": "many" }
        }
      },
      {
        "name": "comment",
        "kind": "create",
        "table": "comments",
        "relation": {
          "nodes": {
            "b": { "kind": "ref", "binding": "post", "scope": "b" },
            "c": { "kind": "project", "input": "b", "fields": [
              { "as": "id",      "expr": { "kind": "lit", "value": { "type": "text", "value": "c1" } } },
              { "as": "post_id", "expr": { "kind": "col", "scope": "b", "column": "id" } },
              { "as": "body",    "expr": { "kind": "lit", "value": { "type": "text", "value": "nice post" } } }
            ] }
          },
          "root": { "node": "c", "cardinality": "many" }
        }
      }
    ],
    "result": "comment"
  },
  "result": [ { "id": "c1", "post_id": "p1", "body": "nice post" } ],
  "assertions": [
    {
      "name": "the comment references the created post",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "comments", "scope": "t" },
          "one": { "kind": "filter", "input": "t", "predicate": { "kind": "binary", "op": "eq",
            "left": { "kind": "col", "scope": "t", "column": "id" }, "right": { "kind": "lit", "value": { "type": "text", "value": "c1" } } } }
        },
        "root": { "node": "one", "cardinality": "exactly_one" }
      },
      "expect": { "id": "c1", "post_id": "p1", "body": "nice post" }
    },
    {
      "name": "the post references the created user",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "posts", "scope": "t" },
          "one": { "kind": "filter", "input": "t", "predicate": { "kind": "binary", "op": "eq",
            "left": { "kind": "col", "scope": "t", "column": "id" }, "right": { "kind": "lit", "value": { "type": "text", "value": "p1" } } } }
        },
        "root": { "node": "one", "cardinality": "exactly_one" }
      },
      "expect": { "id": "p1", "user_id": "u1", "title": "hello" }
    }
  ]
}
