# bug_int_overflow_silent — int64 `add` at MaxInt64 silently wraps (two's
# complement) to MinInt64 and returns HTTP 200 with the wrong value, instead
# of a clean execution_failed. See BUG.md.
tables:
  - name: nums
    columns:
      - { name: id, type: string, pk: true }
      - { name: a,  type: int64 }
      - { name: b,  type: int64 }
