      },
      "expect": [ { "id": "ligature-expanded", "value": "ff" } ]
    },
    {
      "name": "supplementary-plane Deseret letters fold without byte slicing bugs",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "samples", "scope": "t" },
          "f": { "kind": "filter", "input": "t", "predicate": {
            "kind": "text_match", "value": { "kind": "col", "scope": "t", "column": "value" },
            "comparison": "unicode_simple_fold", "parts": [ { "kind": "literal", "value": "𐐀" } ]
