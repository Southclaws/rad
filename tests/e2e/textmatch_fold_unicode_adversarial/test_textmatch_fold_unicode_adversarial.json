{
  "program": {
    "statements": [
      {
        "name": "ascii_case_fold",
        "kind": "query",
        "relation": {
          "nodes": {
            "t": { "kind": "scan", "table": "samples", "scope": "t" },
            "f": { "kind": "filter", "input": "t", "predicate": {
              "kind": "text_match",
              "value": { "kind": "col", "scope": "t", "column": "value" },
              "comparison": "unicode_simple_fold",
              "parts": [ { "kind": "literal", "value": "foo" } ]
            } },
            "o": { "kind": "order", "input": "f", "terms": [
              { "expr": { "kind": "col", "scope": "t", "column": "id" } }
            ] }
          },
          "root": { "node": "o", "cardinality": "many" }
        }
      }
    ]
  },
  "result": [
    { "id": "ascii-lower", "value": "foo" },
    { "id": "ascii-mixed", "value": "fOo" },
    { "id": "ascii-upper", "value": "FOO" }
  ],
  "assertions": [
    {
      "name": "Kelvin sign shares the K/k Unicode simple-fold cycle",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "samples", "scope": "t" },
          "f": { "kind": "filter", "input": "t", "predicate": {
            "kind": "text_match", "value": { "kind": "col", "scope": "t", "column": "value" },
            "comparison": "unicode_simple_fold", "parts": [ { "kind": "literal", "value": "k" } ]
          } },
          "o": { "kind": "order", "input": "f", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "id" } } ] }
        },
        "root": { "node": "o", "cardinality": "many" }
      },
      "expect": [
        { "id": "kelvin-ascii-lower", "value": "k" },
        { "id": "kelvin-ascii-upper", "value": "K" },
        { "id": "kelvin-sign", "value": "K" }
      ]
    },
    {
      "name": "long s shares the S/s Unicode simple-fold cycle",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "samples", "scope": "t" },
          "f": { "kind": "filter", "input": "t", "predicate": {
            "kind": "text_match", "value": { "kind": "col", "scope": "t", "column": "value" },
            "comparison": "unicode_simple_fold", "parts": [ { "kind": "literal", "value": "s" } ]
          } },
          "o": { "kind": "order", "input": "f", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "id" } } ] }
        },
        "root": { "node": "o", "cardinality": "many" }
      },
      "expect": [
        { "id": "long-s", "value": "ſ" },
        { "id": "long-s-ascii-lower", "value": "s" },
        { "id": "long-s-ascii-upper", "value": "S" }
      ]
    },
    {
      "name": "capital normal and final Greek sigma are one simple-fold class",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "samples", "scope": "t" },
          "f": { "kind": "filter", "input": "t", "predicate": {
            "kind": "text_match", "value": { "kind": "col", "scope": "t", "column": "value" },
            "comparison": "unicode_simple_fold", "parts": [ { "kind": "literal", "value": "σ" } ]
          } },
          "o": { "kind": "order", "input": "f", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "id" } } ] }
        },
        "root": { "node": "o", "cardinality": "many" }
      },
      "expect": [
        { "id": "sigma-capital", "value": "Σ" },
        { "id": "sigma-final", "value": "ς" },
        { "id": "sigma-small", "value": "σ" }
      ]
    },
    {
      "name": "sharp s folds one rune to one rune including capital sharp s",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "samples", "scope": "t" },
          "f": { "kind": "filter", "input": "t", "predicate": {
            "kind": "text_match", "value": { "kind": "col", "scope": "t", "column": "value" },
            "comparison": "unicode_simple_fold", "parts": [ { "kind": "literal", "value": "straße" } ]
          } },
          "o": { "kind": "order", "input": "f", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "id" } } ] }
        },
        "root": { "node": "o", "cardinality": "many" }
      },
      "expect": [
        { "id": "sharp-simple-lower", "value": "Straße" },
        { "id": "sharp-simple-upper", "value": "STRAẞE" }
      ]
    },
    {
      "name": "sharp s never expands to ss under simple folding",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "samples", "scope": "t" },
          "f": { "kind": "filter", "input": "t", "predicate": {
            "kind": "text_match", "value": { "kind": "col", "scope": "t", "column": "value" },
            "comparison": "unicode_simple_fold", "parts": [ { "kind": "literal", "value": "STRASSE" } ]
          } },
          "o": { "kind": "order", "input": "f", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "id" } } ] }
        },
        "root": { "node": "o", "cardinality": "many" }
      },
      "expect": [ { "id": "sharp-expanded", "value": "STRASSE" } ]
    },
    {
      "name": "accented composed letters fold case but not accents or normalization",
