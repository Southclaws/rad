{
  "program": {
    "statements": [
      {
        "name": "swap",
        "kind": "update",
        "table": "nodes",
        "relation": {
          "nodes": {
            "s": { "kind": "scan", "table": "nodes", "scope": "s" },
            "o": { "kind": "scan", "table": "nodes", "scope": "o" },
            "j": { "kind": "join", "left": "s", "right": "o", "join": "inner",
              "on": { "kind": "binary", "op": "ne",
                "left": { "kind": "col", "scope": "s", "column": "id" },
                "right": { "kind": "col", "scope": "o", "column": "id" } } },
            "p": { "kind": "project", "input": "j", "fields": [
              { "as": "id", "expr": { "kind": "col", "scope": "s", "column": "id" } },
              { "as": "n",  "expr": { "kind": "col", "scope": "o", "column": "n" } }
            ] }
          },
          "root": { "node": "p", "cardinality": "many" }
        }
      }
    ]
  },
  "assertions": [
    {
      "name": "values were swapped from the pre-statement snapshot, not self-observed",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "nodes", "scope": "t" },
          "o": { "kind": "order", "input": "t", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "id" } } ] }
        },
        "root": { "node": "o", "cardinality": "many" }
      },
      "expect": [ { "id": "a", "n": 2 }, { "id": "b", "n": 1 } ]
    }
  ]
}
