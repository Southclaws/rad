# e2e/errbind_non_bool_predicate — a filter whose predicate is a bare int64
# column is not boolean and must be rejected. Code captured by running.
tables:
  - name: widgets
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }
      - { name: qty,  type: int64 }
