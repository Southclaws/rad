# expr_nested — nested compound arithmetic (a add b) mul (c sub d)
# in a projection field, exercising recursive Eval and int64 sign handling.
tables:
  - name: nums
    columns:
      - { name: id, type: string, pk: true }
      - { name: a,  type: int64 }
      - { name: b,  type: int64 }
      - { name: c,  type: int64 }
      - { name: d,  type: int64 }
