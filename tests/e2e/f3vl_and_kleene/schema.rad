# e2e/f3vl_and_kleene — Kleene AND. A row is kept only when (x = 1) and (y = 1)
# is TRUE. NULL operands make a conjunct UNKNOWN; FALSE and UNKNOWN = FALSE,
# TRUE and UNKNOWN = UNKNOWN, UNKNOWN and UNKNOWN = UNKNOWN — all dropped.
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: x,  type: int64, nullable: true }
      - { name: y,  type: int64, nullable: true }
