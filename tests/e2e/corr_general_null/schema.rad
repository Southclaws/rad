# NULL through a GENERAL-correlated (inequality) crossing. The key path's
# NULL short-circuit does NOT apply here; correctness relies on 3VL in the
# residual filter: child.value < NULL is UNKNOWN, so nothing matches.
tables:
  - name: parents
    columns:
      - { name: id,        type: string, pk: true }
      - { name: threshold, type: int64, nullable: true }

  - name: children
    columns:
      - { name: id,    type: string, pk: true }
      - { name: value, type: int64 }
