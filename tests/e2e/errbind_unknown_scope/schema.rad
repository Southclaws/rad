# e2e/errbind_unknown_scope — a col naming a scope label that no node in the
# query binds must be rejected by the binder as invalid, reason unknown_scope.
tables:
  - name: widgets
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }
      - { name: qty,  type: int64 }
