# probe_idx_composite — composite index (a, b): exercises eq-prefix + trailing
# range, eq-only, leading-range, and a non-prefix range (must ignore index).
tables:
  - name: c
    columns:
      - { name: id, type: string, pk: true }
      - { name: a,  type: int64 }
      - { name: b,  type: int64 }
    indexes:
      - { columns: [a, b] }
