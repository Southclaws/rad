# expr_order_arith — order by a computed arithmetic term (a add b).
# SortExec must evaluate the term, and the PK tie-breaker must still apply
# to rows whose computed key ties.
tables:
  - name: nums
    columns:
      - { name: id, type: string, pk: true }
      - { name: a,  type: int64 }
      - { name: b,  type: int64 }
