# bug_idx_inverted_range — a secondary index on n makes the planner choose an
# index range scan. A closed range whose bounds cross (gt 20 AND lt 20) is a
# legal, empty predicate, but the executor encodes start > end and the KV
# Scan rejects it as an internal error instead of yielding zero rows.
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: n,  type: int64 }
    indexes:
      - { columns: [n] }
