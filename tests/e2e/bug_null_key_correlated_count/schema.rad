# e2e/bug_null_key_correlated_count — regression for a bug the generated
# differential oracle found: a correlated scalar(count(...)) whose correlation
# key is NULL must be 0, not NULL. The count's global aggregate produces one
# row (count 0) even when the correlated filter matches nothing; the engine's
# NULL-key short-circuit used to skip the sub-plan and return NULL.
tables:
  - name: items
    columns:
      - { name: id,  type: string, pk: true }
      - { name: ref, type: string, nullable: true }
