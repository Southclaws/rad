# e2e/errbind_scalar_arity — a root scalar over a relation with more than one
# output column must be rejected as invalid. Detail captured by running.
tables:
  - id: 1
    name: widgets
    columns:
      - { id: 1, name: id,   type: string, pk: true }
      - { id: 2, name: name, type: string }
      - { id: 3, name: qty,  type: int64 }
