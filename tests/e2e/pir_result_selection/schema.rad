# e2e/pir_result_selection — three independent create statements; the
# program's explicit `result` names the MIDDLE (non-final) statement, so the
# returned value must be that statement's output, not the last statement's.
tables:
  - name: items
    columns:
      - { name: id,    type: string, pk: true }
      - { name: label, type: string }
