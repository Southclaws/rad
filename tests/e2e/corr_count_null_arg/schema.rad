# count() whose argument is a correlated scalar(min child value). Parents with
# no children yield a NULL scalar (min over empty), which count must SKIP.
tables:
  - name: parents
    columns:
      - { name: id, type: string, pk: true }

  - name: children
    columns:
      - { name: id,        type: string, pk: true }
      - { name: parent_id, type: string, nullable: true, ref: parents.id }
      - { name: value,     type: int64 }
