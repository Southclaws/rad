# self-correlation: each item embeds the array of OTHER items with a strictly
# greater value. Inner scan is the SAME table as the outer, correlated by an
# inequality (general correlation, per-row fallback).
tables:
  - id: 1
    name: items
    columns:
      - { id: 1, name: id,    type: string, pk: true }
      - { id: 2, name: value, type: int64 }
