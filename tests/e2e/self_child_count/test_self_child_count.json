{
  "program": {
    "statements": [
      {
        "name": "nodes_with_child_count",
        "kind": "query",
        "relation": {
          "nodes": {
            "n": { "kind": "scan", "table": "nodes", "scope": "n" },
            "c": { "kind": "scan", "table": "nodes", "scope": "c" },
            "children_of": {
              "kind": "filter",
              "input": "c",
              "predicate": {
                "kind": "binary", "op": "eq",
                "left": { "kind": "col", "scope": "c", "column": "parent_id" },
                "right": { "kind": "col", "scope": "n", "column": "id" }
              }
            },
            "counted": {
              "kind": "aggregate",
              "input": "children_of",
              "scope": "g",
              "aggs": [ { "fn": "count", "as": "kids" } ]
            },
            "out": {
              "kind": "project",
              "input": "n",
              "scope": "o",
              "fields": [
                { "as": "id",   "expr": { "kind": "col", "scope": "n", "column": "id" } },
                { "as": "kids", "expr": { "kind": "scalar", "node": "counted" } }
              ]
            },
            "sorted": {
              "kind": "order",
              "input": "out",
              "terms": [ { "expr": { "kind": "col", "scope": "o", "column": "id" } } ]
            }
          },
          "root": { "node": "sorted", "cardinality": "many" }
        }
      }
    ]
  },
  "result": [
    { "id": "n1", "kids": 2 },
    { "id": "n2", "kids": 1 },
    { "id": "n3", "kids": 0 },
    { "id": "n4", "kids": 0 },
    { "id": "n5", "kids": 0 }
  ]
}
