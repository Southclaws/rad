# e2e/cross_scalar_count — each board embeds a `scalar(...)` correlated
# aggregate: the count of its tasks (one output column, global fold).
tables:
  - name: boards
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: tasks
    columns:
      - { name: id,       type: string, pk: true }
      - { name: board_id, type: string, nullable: true, ref: boards.id }
      - { name: title,    type: string }
