{
  "program": {
    "statements": [
      {
        "name": "q",
        "kind": "query",
        "relation": {
          "nodes": {
            "t": { "kind": "scan", "table": "t", "scope": "t" },
            "kept": {
              "kind": "filter", "input": "t",
              "predicate": {
                "kind": "binary", "op": "and",
                "left": { "kind": "binary", "op": "gt", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "apple" } },
                "right": { "kind": "binary", "op": "lt", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "date" } }
              }
            },
            "sorted": { "kind": "order", "input": "kept", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "s" } } ] }
          },
          "root": { "node": "sorted", "cardinality": "many" }
        }
      }
    ]
  },
  "result": [ { "id": "b", "s": "banana" }, { "id": "c", "s": "cherry" } ],
  "assertions": [
    {
      "name": "inclusive closed range banana..cherry",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "t", "scope": "t" },
          "kept": {
            "kind": "filter", "input": "t",
            "predicate": {
              "kind": "binary", "op": "and",
              "left": { "kind": "binary", "op": "gte", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "banana" } },
              "right": { "kind": "binary", "op": "lte", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "cherry" } }
            }
          },
          "sorted": { "kind": "order", "input": "kept", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "s" } } ] }
        },
        "root": { "node": "sorted", "cardinality": "many" }
      },
      "expect": [ { "id": "b", "s": "banana" }, { "id": "c", "s": "cherry" } ]
    },
    {
      "name": "s < 'apple' is empty (apple is the min)",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "t", "scope": "t" },
          "kept": { "kind": "filter", "input": "t", "predicate": { "kind": "binary", "op": "lt", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "apple" } } },
          "sorted": { "kind": "order", "input": "kept", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "s" } } ] }
        },
        "root": { "node": "sorted", "cardinality": "many" }
      },
      "expect": []
    },
    {
      "name": "prefix boundary: s < 'b' keeps only apple",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "t", "scope": "t" },
          "kept": { "kind": "filter", "input": "t", "predicate": { "kind": "binary", "op": "lt", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "b" } } },
          "sorted": { "kind": "order", "input": "kept", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "s" } } ] }
        },
        "root": { "node": "sorted", "cardinality": "many" }
      },
      "expect": [ { "id": "a", "s": "apple" } ]
    },
    {
      "name": "prefix boundary: s >= 'app' keeps all (app < apple)",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "t", "scope": "t" },
          "kept": { "kind": "filter", "input": "t", "predicate": { "kind": "binary", "op": "gte", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "app" } } },
          "sorted": { "kind": "order", "input": "kept", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "s" } } ] }
        },
        "root": { "node": "sorted", "cardinality": "many" }
      },
      "expect": [ { "id": "a", "s": "apple" }, { "id": "b", "s": "banana" }, { "id": "c", "s": "cherry" }, { "id": "d", "s": "date" } ]
    },
    {
      "name": "s > 'cherry' keeps only date",
      "query": {
        "nodes": {
          "t": { "kind": "scan", "table": "t", "scope": "t" },
          "kept": { "kind": "filter", "input": "t", "predicate": { "kind": "binary", "op": "gt", "left": { "kind": "col", "scope": "t", "column": "s" }, "right": { "kind": "lit", "value": "cherry" } } },
          "sorted": { "kind": "order", "input": "kept", "terms": [ { "expr": { "kind": "col", "scope": "t", "column": "s" } } ] }
        },
        "root": { "node": "sorted", "cardinality": "many" }
      },
      "expect": [ { "id": "d", "s": "date" } ]
    }
  ]
}
