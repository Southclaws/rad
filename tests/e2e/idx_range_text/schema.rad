# probe_idx_text — range bounds on a text index: lexical order, exact
# endpoints, and prefix boundaries ("app" < "apple") that stress the
# self-delimiting string encoding + PrefixEnd.
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: s,  type: string }
    indexes:
      - { columns: [s] }
