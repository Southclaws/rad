# expr_agg_over_expr — aggregate functions over computed arguments:
# sum(a mul b), avg(cast(n to float64)), min(negate(x)), count(a sub b).
# NULL operands make the per-row arg NULL, which the folds must skip.
tables:
  - name: nums
    columns:
      - { name: id, type: string, pk: true }
      - { name: a,  type: int64, nullable: true }
      - { name: b,  type: int64, nullable: true }
      - { name: x,  type: int64 }
      - { name: n,  type: int64, nullable: true }
