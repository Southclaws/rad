# expr_agg_over_expr — aggregate functions over computed arguments:
# sum(a mul b), avg(cast(n to float64)), min(negate(x)), count(a sub b).
# NULL operands make the per-row arg NULL, which the folds must skip.
tables:
  - id: 1
    name: nums
    columns:
      - { id: 1, name: id, type: string, pk: true }
      - { id: 2, name: a,  type: int64, nullable: true }
      - { id: 3, name: b,  type: int64, nullable: true }
      - { id: 4, name: x,  type: int64 }
      - { id: 5, name: n,  type: int64, nullable: true }
