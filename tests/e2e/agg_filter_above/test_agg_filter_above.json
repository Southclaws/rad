{
  "program": {
    "statements": [
      {
        "name": "busy_regions",
        "kind": "query",
        "relation": {
          "nodes": {
            "t": { "kind": "scan", "table": "sales", "scope": "t" },
            "agg": { "kind": "aggregate", "input": "t", "scope": "g",
              "groups": [ { "as": "region", "expr": { "kind": "col", "scope": "t", "column": "region" } } ],
              "aggs": [ { "fn": "count", "as": "n" } ] },
            "big": { "kind": "filter", "input": "agg",
              "predicate": { "kind": "binary", "op": "gt",
                "left": { "kind": "col", "scope": "g", "column": "n" },
                "right": { "kind": "lit", "value": { "type": "int64", "value": "1" } } } },
            "ord": { "kind": "order", "input": "big",
              "terms": [ { "expr": { "kind": "col", "scope": "g", "column": "region" } } ] }
          },
          "root": { "node": "ord", "cardinality": "many" }
        }
      }
    ]
  },
  "result": [
    { "region": "east", "n": 2 },
    { "region": "west", "n": 3 }
  ]
}
