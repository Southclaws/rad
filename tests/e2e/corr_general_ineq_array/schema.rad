# parents with a threshold; children with a value. The crossing correlates
# by INEQUALITY (child.value < parent.threshold), so it cannot be the batched
# key path — it must fall back to general per-row nested evaluation.
tables:
  - name: parents
    columns:
      - { name: id,        type: string, pk: true }
      - { name: threshold, type: int64 }

  - name: children
    columns:
      - { name: id,    type: string, pk: true }
      - { name: value, type: int64 }
