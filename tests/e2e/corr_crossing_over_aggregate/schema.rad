# a crossing whose relation is a correlated GROUP BY aggregate: each parent
# embeds an array of {category, count} folded over ITS children only.
tables:
  - id: 1
    name: parents
    columns:
      - { id: 1, name: id, type: string, pk: true }

  - id: 2
    name: children
    columns:
      - { id: 1, name: id,        type: string, pk: true }
      - { id: 2, name: parent_id, type: string, nullable: true, ref: parents.id }
      - { id: 3, name: category,  type: string }
