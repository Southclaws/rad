# e2e/f3vl_ne_skips_null — one table with a nullable int column, to prove a
# `ne` (x != v) filter drops NULL rows: a comparison with NULL is UNKNOWN,
# and filter keeps only TRUE.
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: x,  type: int64, nullable: true }
