# e2e/pir_query_then_mutate — the first statement is a `query` selecting a
# user; a later `update` statement consumes that query's result through a
# `ref` binding, pulling the queried user's name into a post's title. Proves
# a query statement's output is a first-class binding a mutation can drive.
tables:
  - name: users
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }
  - name: posts
    columns:
      - { name: id,      type: string, pk: true }
      - { name: user_id, type: string, ref: users.id }
      - { name: title,   type: string }
