# probe_idx_unique_first — an eq filter covering a UNIQUE index proves
# at-most-one row, so `first` with NO explicit order must bind and return the
# single matching row deterministically.
tables:
  - name: users
    columns:
      - { name: id,    type: string, pk: true }
      - { name: email, type: string }
      - { name: name,  type: string }
    indexes:
      - { columns: [email], unique: true }
