# e2e/f3vl_not_eq_skips_null — the load-bearing K3 rule: not(x = v) does NOT
# match rows where x is NULL. eq against NULL is UNKNOWN, and not(UNKNOWN) is
# UNKNOWN, which filter drops.
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: x,  type: int64, nullable: true }
