# e2e/f3vl_is_null_matches — is_null / is_not_null are total tests (never
# UNKNOWN). is_null matches exactly the NULL rows, is_not_null exactly the
# non-NULL rows, and together they partition the table.
tables:
  - name: t
    columns:
      - { name: id, type: string, pk: true }
      - { name: x,  type: int64, nullable: true }
