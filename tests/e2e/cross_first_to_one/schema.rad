# e2e/cross_first_to_one — boards and tasks. Each task embeds its board via a
# to-one `first(...)` crossing whose correlated filter matches the board PK.
tables:
  - id: 1
    name: boards
    columns:
      - { id: 1, name: id,   type: string, pk: true }
      - { id: 2, name: name, type: string }

  - id: 2
    name: tasks
    columns:
      - { id: 1, name: id,       type: string, pk: true }
      - { id: 2, name: board_id, type: string, nullable: true, ref: boards.id }
      - { id: 3, name: title,    type: string }
