# e2e/cross_first_to_one — boards and tasks. Each task embeds its board via a
# to-one `first(...)` crossing whose correlated filter matches the board PK.
tables:
  - name: boards
    columns:
      - { name: id,   type: string, pk: true }
      - { name: name, type: string }

  - name: tasks
    columns:
      - { name: id,       type: string, pk: true }
      - { name: board_id, type: string, nullable: true, ref: boards.id }
      - { name: title,    type: string }
