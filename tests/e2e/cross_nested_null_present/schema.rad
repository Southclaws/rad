# probe: left join fan-out (one left row -> many right), zero (NULL pad), one.
tables:
  - name: owners
    columns:
      - { name: oid,  type: string, pk: true }
      - { name: oname, type: string }

  - name: pets
    columns:
      - { name: pid,      type: string, pk: true }
      - { name: owner_id, type: string, nullable: true, ref: owners.oid }
      - { name: pname,    type: string }
