# A schema within the shape the generator drives: every table has a single text
# "id" primary key, an optional nullable text foreign key to an earlier table,
# and non-unique secondary indexes. The generator synthesises data and
# bind-valid queries against it, and the differential holds the engine's chosen
# plan equal to the reference interpreter.
tables:
  - name: authors
    columns:
      - { name: id,     type: string, pk: true }
      - { name: name,   type: string }
      - { name: rating, type: int64, nullable: true }
      - { name: active, type: bool }
    indexes:
      - { columns: [rating] }

  - name: books
    columns:
      - { name: id,        type: string, pk: true }
      - { name: title,     type: string }
      - { name: pages,     type: int64 }
      - { name: price,     type: float64, nullable: true }
      - { name: author_id, type: string, nullable: true, ref: authors.id }
    indexes:
      - { columns: [pages] }
